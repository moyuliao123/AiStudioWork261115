rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint: CafeProfile
    function isValidCafeProfile(data) {
      return data.keys().hasAll([
          'uid',
          'roomId',
          'nickname',
          'portion',
          'flavor',
          'item',
          'totalFocusMinutes',
          'isFocusing',
          'ambienceLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'roomId',
          'nickname',
          'portion',
          'flavor',
          'item',
          'totalFocusMinutes',
          'isFocusing',
          'ambienceLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.roomId == 'main-cafe'
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 20
        && data.portion is string
        && data.portion.size() >= 1
        && data.portion.size() <= 16
        && data.flavor is string
        && data.flavor.size() >= 1
        && data.flavor.size() <= 16
        && data.item is string
        && data.item.size() >= 1
        && data.item.size() <= 24
        && (data.totalFocusMinutes is int || data.totalFocusMinutes is float)
        && data.totalFocusMinutes >= 0
        && data.totalFocusMinutes <= 100000
        && data.isFocusing is bool
        && data.ambienceLabel is string
        && data.ambienceLabel.size() >= 1
        && data.ambienceLabel.size() <= 24
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // CafeProfile update actions
    function isCafeProfileCustomizingAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'nickname',
          'portion',
          'flavor',
          'item',
          'isFocusing',
          'ambienceLabel',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().totalFocusMinutes == existing().totalFocusMinutes
        && incoming().updatedAt == request.time;
    }

    function isCafeProfileFocusProgressAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'totalFocusMinutes',
          'isFocusing',
          'ambienceLabel',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().totalFocusMinutes >= existing().totalFocusMinutes
        && incoming().totalFocusMinutes <= existing().totalFocusMinutes + 120
        && incoming().updatedAt == request.time;
    }

    // Validation Blueprint: MoodNote
    function isValidMoodNote(data) {
      return data.keys().hasAll([
          'uid',
          'roomId',
          'authorDisplay',
          'content',
          'mood',
          'color',
          'focusMinutes',
          'ambienceLabel',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'roomId',
          'authorDisplay',
          'content',
          'mood',
          'color',
          'focusMinutes',
          'ambienceLabel',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.roomId == 'main-cafe'
        && data.authorDisplay is string
        && data.authorDisplay.size() >= 1
        && data.authorDisplay.size() <= 80
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 120
        && data.mood in ['平靜', '充實', '靈感', '微累', '咖啡續命中']
        && data.color in ['butter', 'apricot', 'matcha', 'sky', 'rose']
        && (data.focusMinutes is int || data.focusMinutes is float)
        && data.focusMinutes >= 1
        && data.focusMinutes <= 120
        && data.ambienceLabel is string
        && data.ambienceLabel.size() >= 1
        && data.ambienceLabel.size() <= 24
        && data.createdAt == request.time;
    }

    // Validation Blueprint: ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'uid',
          'roomId',
          'authorName',
          'authorRecipe',
          'text',
          'messageType',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'roomId',
          'authorName',
          'authorRecipe',
          'text',
          'messageType',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.roomId == 'main-cafe'
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 20
        && data.authorRecipe is string
        && data.authorRecipe.size() >= 1
        && data.authorRecipe.size() <= 64
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 200
        && data.messageType in ['chat', 'unlock']
        && data.createdAt == request.time;
    }

    // Startup connectivity check document
    match /test/connection {
      allow get: if true;
    }

    // Public café patron profiles (zero PII)
    match /cafeProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().roomId == 'main-cafe';
      allow list: if isSignedIn() && existing().roomId == 'main-cafe';
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidCafeProfile(incoming())
        && incoming().totalFocusMinutes == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidCafeProfile(incoming())
        && (isCafeProfileCustomizingAction() || isCafeProfileFocusProgressAction());
      allow delete: if false;
    }

    // Shared café mood sticky note wall
    match /moodNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && existing().roomId == 'main-cafe';
      allow list: if isSignedIn() && existing().roomId == 'main-cafe';
      allow create: if isVerifiedUser()
        && isValidId(noteId)
        && isValidMoodNote(incoming());
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(noteId)
        && existing().uid == request.auth.uid;
    }

    // Live café text chat
    match /chatMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && existing().roomId == 'main-cafe';
      allow list: if isSignedIn() && existing().roomId == 'main-cafe';
      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidChatMessage(incoming());
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(messageId)
        && existing().uid == request.auth.uid;
    }
  }
}
